# Copy to .env at repo root (do not commit .env).
# Frontend and backend load env from the repo root.

# PostgreSQL (Neon / production) — required
DATABASE_URL=

# Auth.js / NextAuth — required
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=
NEXT_PUBLIC_APP_URL=

# Optional — CRM dashboard URL when sharing DATABASE_URL
NEXT_PUBLIC_CRM_URL=

# Optional — Vercel Blob for menu image uploads in production
# BLOB_READ_WRITE_TOKEN=
